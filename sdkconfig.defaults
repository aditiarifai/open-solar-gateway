# Konfigurasi ESP-IDF untuk Rust
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_PTHREAD_STACK_MIN=4096

# Ukuran Flash ESP32-C3 Super Mini adalah 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Gunakan Custom Partition Table dengan Partisi Telemetry 1MB
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="C:/esp-target/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="C:/esp-target/partitions.csv"

# Optimasi UART buffer
CONFIG_UART_ISR_IN_IRAM=y

# Wajib untuk ESP32-C3 SuperMini (Native USB Serial/JTAG pada port USB Type-C)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Bluetooth Low Energy (NimBLE) + Wi-Fi Coexistence untuk JK Smart BMS
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
